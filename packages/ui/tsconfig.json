{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@workspace/ui/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "composite": true,
    "incremental": true
  },
  "include": ["src/**/*", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
